# Copy to .env and fill in. Never commit .env.

# ---- Model ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Reasoning depth for the agent: low | medium | high. Medium suits fast multi-step tool use.
ANTHROPIC_EFFORT=medium
# Re-run a safety-declined request on a fallback model server side. 0 turns it off.
ANTHROPIC_FALLBACKS=1
# Optional overrides for the eval judge and the onboarding drafter
ANTHROPIC_JUDGE_MODEL=claude-haiku-5-5
ANTHROPIC_DRAFT_MODEL=

# ---- Adapters (everything defaults to the mock, so the demo needs no extra services) ----
CHANNEL_ADAPTER=mock        # mock | twilio (stub, not wired)
CRM_ADAPTER=mock            # mock | hubspot
CALENDAR_ADAPTER=mock       # mock | google (stub, not wired)
NOTIFIER_ADAPTER=mock       # mock | slack

# HubSpot (CRM_ADAPTER=hubspot). Private app token from a free developer account.
HUBSPOT_TOKEN=

# Slack (NOTIFIER_ADAPTER=slack). An incoming webhook URL.
SLACK_WEBHOOK_URL=

# Twilio (stub)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Server ------------------------------------------------------------------
DATABASE_PATH=data/leadagent.db
# Company the API and UI open with. run.py --company sets this for you.
DEFAULT_COMPANY=
# If set, /api/intake/* webhooks require the header X-Webhook-Secret with this value.
WEBHOOK_SECRET=
# Extra browser origins allowed to call the API (comma separated)
CORS_ORIGINS=
# Where company folders and eval scenarios live, if not the defaults
COMPANIES_DIR=
SCENARIOS_DIR=
