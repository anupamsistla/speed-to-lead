# Copy to .env and fill in. Never commit .env.

# Model used by the agent (default: claude-sonnet-5-5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Adapter selection. Everything defaults to the mock implementation.
CHANNEL_ADAPTER=mock        # mock | twilio (stub)
CRM_ADAPTER=mock            # mock | hubspot
CALENDAR_ADAPTER=mock       # mock | google (stub)
NOTIFIER_ADAPTER=mock       # mock | slack

# HubSpot (only when CRM_ADAPTER=hubspot). Private app token from a free developer account.
HUBSPOT_TOKEN=

# Slack (only when NOTIFIER_ADAPTER=slack). Incoming webhook URL.
SLACK_WEBHOOK_URL=

# Twilio (stub, not wired yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local state
DATABASE_PATH=data/leadagent.db
